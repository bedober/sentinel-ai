# Generate a long random value; never commit real credentials.
SENTINEL_WORKER_TOKEN=replace-with-a-long-random-secret
# Token entered by the Android app; keep separate from the internal worker token.
SENTINEL_CLIENT_TOKEN=replace-with-another-long-random-secret
# Comma-separated CIDRs only. Add only networks you own or have written approval to test.
SENTINEL_ALLOWED_CIDRS=192.0.2.10/32
SENTINEL_WORKER_URL=http://worker:8090
